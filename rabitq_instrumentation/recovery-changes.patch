+    FiQueryStats fi_qstats_;
+    void fi_reset_query_stats() { fi_qstats_ = FiQueryStats{}; }
+
+    // On-access CRC of one element's ex window, against the manifest's expected value.
+    // Recomputed every call by design (see fi_crc_seen_fail_ above on why not memoized).
+    [[nodiscard]] inline bool ex_corrupted_now(PID id) {
+        // Bounds guard. The FAULT_DROP consult sits BEFORE the fi_safe_mode_ bounds check, so
+        // a structurally-corrupt neighbour id can reach here. In load mode that is a 1-byte
+        // read past ex_corrupt_; in lazy mode it would be a 96-byte read at a wild address.
+        // Report it as a counter and treat the element as intact -- never silently.
+        if (static_cast<size_t>(id) >= static_cast<size_t>(cur_element_count_)) {
+            fi_qstats_.crc_oob_skipped++;
+            return false;
+        }
+        const char* ex = data_level0_memory_ +
+                         (static_cast<size_t>(id) * size_data_per_element_) + fi_crc_field_off_;
+        fi_qstats_.crc_checks++;
+        fi_qstats_.crc_bytes += fi_crc_field_len_;
+        uint32_t got = 0;
+        if (fi_crc_timer_) {
+            // Opt-in: two steady_clock reads (~40-50 ns) against a ~96-byte software CRC
+            // (~100-200 ns) inflate the very number being measured, and would also pollute
+            // exp_dumpids' search_wall_ns -- which is the unperturbed load-vs-lazy delta the
+            // acceptance run quotes as the headline overhead. Off by default for that reason.
+            const auto t0 = std::chrono::steady_clock::now();
+            got = fi_crc32(ex, fi_crc_field_len_);
+            fi_qstats_.crc_ns += static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    std::chrono::steady_clock::now() - t0)
+                    .count());
+        } else {
+            got = fi_crc32(ex, fi_crc_field_len_);
+        }
+        const bool bad = (got != fi_crc_expect_[id]);
+        if (bad && fi_crc_seen_fail_[id] == 0) {
+            fi_crc_seen_fail_[id] = 1;
+            fi_crc_distinct_failed_++;
+        }
+        return bad;
+    }
+
+    // The ONLY place the two modes diverge. Same predicate, same call sites, same decisions:
+    // load answers from the bitmap the eager scan filled, lazy computes the answer now.
+    [[nodiscard]] inline bool ex_bad(PID id) {
+        return fi_crc_lazy_ ? ex_corrupted_now(id) : ex_corrupted(id);
+    }
