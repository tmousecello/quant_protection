+    bool fi_crc_mode_ = false;
+    bool fi_crc_lazy_ = false;   // false = load (eager scan), true = lazy (on-access)
+    bool fi_crc_timer_ = false;  // time each on-access CRC (see fi_qstats_.crc_ns)
+    size_t fi_crc_checked_ = 0;  // load-time scan: elements CRC-verified
