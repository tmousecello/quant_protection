+    // element (4 MB at 1M) instead of 1 B, in exchange for not touching a single ex byte at
+    // load. field_off/field_len were locals of load_crc_manifest() and must survive it.
+    std::vector<uint32_t> fi_crc_expect_;
+    size_t fi_crc_field_off_ = 0;
+    size_t fi_crc_field_len_ = 0;
+    // Stats only: which elements have EVER failed an on-access check in this process. Never
+    // read by any decision -- it exists so the acceptance gate can compare lazy's distinct
+    // failure count against load's whole-index count. Deliberately NOT a verdict cache:
+    // memoizing would make the measured detection overhead a best case instead of the
+    // worst-case cold path we want to report.
+    std::vector<uint8_t> fi_crc_seen_fail_;
+    size_t fi_crc_distinct_failed_ = 0;
+    struct FiQueryStats {        // per-query recovery counters (single-thread search only;
+        uint64_t consults = 0;   //   caller resets between queries via fi_reset_query_stats)
+        uint64_t corrupt_hits = 0;
+        uint64_t fallbacks = 0;  // candidates ranked by the EB pessimistic bound
+        uint64_t drops = 0;      // candidates skipped under FAULT_DROP
+        // --crc-mode lazy only (all stay 0 under load: the query path computes no CRC).
+        uint64_t crc_checks = 0;      // on-access CRCs computed
+        uint64_t crc_bytes = 0;       // bytes fed to those CRCs
+        uint64_t crc_ns = 0;          // time inside them, iff fi_crc_timer_ (else 0)
+        uint64_t crc_oob_skipped = 0; // consults with an out-of-range id (see below)
