+    // CRC-32/ISO-HDLC (poly 0xEDB88320 reflected, init/final-xor 0xFFFFFFFF) == zlib.crc32,
+    // the exact algorithm the Python manifest writer uses (manifest algo tag 1).
+    //
+    // The kernel is selected at load time via fi_crc_impl_ (rabitqlib/qp_crc32.hpp). Every impl
+    // is bit-identical to zlib.crc32 -- proven exhaustively by
+    // artifacts/phase3/tests/test_crc_kernel.py -- so this selects SPEED ONLY and can never
+    // change a verdict, an id, or a recall. That is what makes the kernel swap a no-op for every
+    // frozen manifest and expb record. A member rather than a static so the four existing call
+    // sites are untouched; the original byte-at-a-time loop lives on as qp_crc::kTable.
+    int fi_crc_impl_ = qp_crc::kTable;
+
+    [[nodiscard]] uint32_t fi_crc32(const char* data, size_t n) const {
+        return qp_crc::crc32(fi_crc_impl_, data, n);
+    }
+
+    // Load a qp CRC manifest (crc_manifest.py: 64-B header + n x {u64 off, u32 len, u32 crc},
+    // little-endian) and arm `policy` (FAULT_DROP or FAULT_FALLBACK_EB). Call AFTER load().
+    // Throws on any header/geometry mismatch -- pairing the wrong manifest with the wrong
+    // index must fail loudly, not skew results silently.
+    //
+    // PARSE (both modes): header, geometry echo, entry-array read, and the per-entry
+    // offset/len re-derivation. ARM: `lazy=false` runs the eager scan exactly as before and
+    // fills ex_corrupt_; `lazy=true` keeps the expected CRCs instead and touches no ex byte
+    // until the search consults an element.
+    void load_crc_manifest(const char* path, int policy, bool lazy = false) {
+        // Self-test the SELECTED CRC kernel before trusting a 10^6-element scan to it. Naming
+        // the impl matters: a kernel that is wrong rather than merely slow would flag every
+        // element, which downstream reads as "the index is entirely corrupt" rather than as a
+        // build problem. Note 9 bytes takes the scalar path in every impl, so this also pins
+        // the sub-fold tail that the 96-byte production window never exercises.
+        if (fi_crc32("123456789", 9) != 0xCBF43926U) {
+            throw std::runtime_error(std::string("fi_crc32 self-test failed for impl '") +
+                                     qp_crc::impl_name(fi_crc_impl_) + "'");
+        }
+        std::ifstream mf(path, std::ios::binary);
+        if (!mf.is_open()) {
+            throw std::runtime_error(std::string("cannot open CRC manifest ") + path);
+        }
+        char magic[8];
+        uint32_t version = 0;
+        uint32_t algo = 0;
+        uint32_t field_len = 0;
+        uint32_t reserved = 0;
+        uint64_t n_entries = 0;
+        uint64_t index_file_size = 0;
+        uint64_t level0_start = 0;
+        uint64_t spe = 0;
+        uint64_t field_off = 0;
+        mf.read(magic, 8);
+        mf.read(reinterpret_cast<char*>(&version), 4);
+        mf.read(reinterpret_cast<char*>(&algo), 4);
+        mf.read(reinterpret_cast<char*>(&n_entries), 8);
+        mf.read(reinterpret_cast<char*>(&index_file_size), 8);
+        mf.read(reinterpret_cast<char*>(&level0_start), 8);
+        mf.read(reinterpret_cast<char*>(&spe), 8);
+        mf.read(reinterpret_cast<char*>(&field_off), 8);
+        mf.read(reinterpret_cast<char*>(&field_len), 4);
+        mf.read(reinterpret_cast<char*>(&reserved), 4);
+        const char kMagic[8] = {'Q', 'P', 'C', 'R', 'C', 'M', 'F', '\x01'};
+        bool magic_ok = static_cast<bool>(mf);
+        for (int i = 0; i < 8; i++) {
+            magic_ok = magic_ok && magic[i] == kMagic[i];
+        }
+        if (!magic_ok) {
+            throw std::runtime_error("bad CRC manifest magic/header");
+        }
+        if (version != 1 || algo != 1) {
+            throw std::runtime_error("unsupported CRC manifest version/algo");
+        }
+        // Geometry echo checks: manifest must describe THIS index's layout. level0 start on
+        // disk = 156-B header + centroids (mirrors save()); the CRC'd field window must lie
+        // inside the ex block (ex_corrupt_ drives EX-recovery semantics -- a manifest over
+        // bin/links would silently mean something else).
+        const uint64_t want_level0 =
+            156 + static_cast<uint64_t>(num_cluster_) * padded_dim_ * sizeof(float);
+        if (n_entries != cur_element_count_ || level0_start != want_level0 ||
+            spe != size_data_per_element_ || field_off < offsetExData_ ||
+            field_off + field_len > offsetExData_ + size_ex_data_) {
+            throw std::runtime_error("CRC manifest geometry does not match loaded index");
+        }
+        struct Entry {
+            uint64_t off;
+            uint32_t len;
+            uint32_t crc;
+        };
+        static_assert(sizeof(Entry) == 16, "manifest entry must be packed to 16 bytes");
+        std::vector<Entry> entries(n_entries);
+        mf.read(reinterpret_cast<char*>(entries.data()),
+                static_cast<std::streamsize>(n_entries * sizeof(Entry)));
+        if (!mf) {
+            throw std::runtime_error("CRC manifest truncated");
+        }
+        ex_corrupt_.assign(cur_element_count_, 0);
+        fi_crc_checked_ = 0;
+        fi_crc_failed_ = 0;
+        fi_crc_scan_ns_ = 0;
+        fi_crc_lazy_ = lazy;
+        fi_crc_field_off_ = static_cast<size_t>(field_off);
+        fi_crc_field_len_ = static_cast<size_t>(field_len);
+        fi_crc_expect_.clear();
+        fi_crc_seen_fail_.clear();
+        fi_crc_distinct_failed_ = 0;
+        if (lazy) {
+            fi_crc_expect_.resize(n_entries);
+            fi_crc_seen_fail_.assign(cur_element_count_, 0);
+        }
+        // Entry geometry re-derivation -- integer-only, touches no ex byte, so it runs in
+        // both modes and (unlike before) sits OUTSIDE the eager scan's timer. That makes
+        // crc_scan_ns a pure CRC cost; the shift is ~2 integer compares per element against
+        // a 96-byte CRC, i.e. far below the measurement's own noise.
+        for (uint64_t i = 0; i < n_entries; i++) {
+            if (entries[i].off != level0_start + i * spe + field_off ||
+                entries[i].len != field_len) {
+                throw std::runtime_error("CRC manifest entry offset/len mismatch");
+            }
+            if (lazy) {
+                fi_crc_expect_[i] = entries[i].crc;
+            }
+        }
+        if (!lazy) {
+            const auto scan_t0 = std::chrono::steady_clock::now();
+            for (uint64_t i = 0; i < n_entries; i++) {
+                // The on-disk LEVEL0 block is a verbatim copy of data_level0_memory_, so the
+                // in-memory bytes at the same per-element offset are the bytes the manifest
+                // CRC'd on disk (offsets within an element are identical).
+                const char* ex = data_level0_memory_ + i * size_data_per_element_ + field_off;
+                fi_crc_checked_++;
+                if (fi_crc32(ex, field_len) != entries[i].crc) {
+                    ex_corrupt_[i] = 1;
+                    fi_crc_failed_++;
+                }
+            }
+            fi_crc_scan_ns_ = static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    std::chrono::steady_clock::now() - scan_t0)
+                    .count());
+        }
+        fault_policy_ = policy;
+        fi_crc_mode_ = true;
+    }
